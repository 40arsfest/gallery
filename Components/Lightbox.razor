@using PhotoGallery.Models
@using PhotoGallery.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (IsOpen && Photos.Count > 0)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-sm"
         @onkeydown="HandleKeyDown"
         tabindex="0"
         @ref="_container"
         role="dialog"
         aria-modal="true"
         aria-label="Bildvisare">
        <div class="absolute right-3 top-3 z-10 flex items-center gap-2">
            @if (_canShare)
            {
                <button type="button"
                        class="flex h-12 w-12 items-center justify-center rounded-full bg-zinc-800/80 text-xl text-zinc-200 transition hover:bg-amber-500 hover:text-zinc-950"
                        @onclick="ShareAsync"
                        aria-label="Dela bild">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                    </svg>
                </button>
            }
            <button type="button"
                    class="flex h-12 w-12 items-center justify-center rounded-full bg-zinc-800/80 text-2xl text-zinc-200 transition hover:bg-amber-500 hover:text-zinc-950"
                    @onclick="Close"
                    aria-label="Stäng">
                ✕
            </button>
        </div>

        @if (Photos.Count > 1)
        {
            <button type="button"
                    class="absolute left-2 top-1/2 z-10 hidden h-14 w-14 -translate-y-1/2 items-center justify-center rounded-full bg-zinc-800/80 text-3xl text-zinc-200 transition hover:bg-amber-500 hover:text-zinc-950 sm:flex"
                    @onclick="Previous"
                    aria-label="Föregående bild">
                ‹
            </button>
            <button type="button"
                    class="absolute right-2 top-1/2 z-10 hidden h-14 w-14 -translate-y-1/2 items-center justify-center rounded-full bg-zinc-800/80 text-3xl text-zinc-200 transition hover:bg-amber-500 hover:text-zinc-950 sm:flex"
                    @onclick="Next"
                    aria-label="Nästa bild">
                ›
            </button>
        }

        <div class="flex max-h-[90vh] max-w-[95vw] flex-col items-center gap-4 px-4"
             @ref="_swipeArea">
            <img src="@CurrentPhoto.ImageUrl"
                 alt="@CurrentPhoto.FileName"
                 class="max-h-[75vh] max-w-full rounded-lg object-contain shadow-2xl" />
            <div class="max-w-lg text-center">
                <p class="text-lg font-medium text-zinc-100">@PhotoQueries.FormatAlbumTitle(CurrentPhoto.Album)</p>
                <p class="mt-0.5 text-sm text-zinc-400">
                    @CurrentPhoto.Year
                    @if (PhotoQueries.FormatDisplayDate(CurrentPhoto.Date) is { } displayDate)
                    {
                        <span> · @displayDate</span>
                    }
                </p>
                @if (Photos.Count > 1)
                {
                    <p class="mt-1 text-xs tabular-nums text-zinc-500">@(_index + 1) / @Photos.Count</p>
                }
                @if (HasMetadata(CurrentPhoto))
                {
                    <div class="mt-3 space-y-1 border-t border-zinc-700/50 pt-3">
                        @if (!string.IsNullOrWhiteSpace(CurrentPhoto.CameraModel))
                        {
                            <p class="text-xs font-medium tracking-wide text-zinc-400">
                                <span class="mr-1" aria-hidden="true">📷</span>@CurrentPhoto.CameraModel
                            </p>
                        }
                        @{
                            var fileSize = PhotoQueries.FormatFileSizeMb(CurrentPhoto.FileSizeBytes);
                            var resolution = PhotoQueries.FormatResolution(CurrentPhoto.Width, CurrentPhoto.Height);
                        }
                        @if (fileSize is not null || resolution is not null)
                        {
                            <p class="text-xs tabular-nums text-zinc-500">
                                @if (fileSize is not null)
                                {
                                    @fileSize
                                }
                                @if (fileSize is not null && resolution is not null)
                                {
                                    <span class="mx-1.5 text-zinc-600">·</span>
                                }
                                @if (resolution is not null)
                                {
                                    @resolution
                                }
                            </p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public IReadOnlyList<PhotoItem> Photos { get; set; } = [];
    [Parameter] public int InitialIndex { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _container;
    private ElementReference _swipeArea;
    private int _index;
    private IJSObjectReference? _module;
    private IJSObjectReference? _swipeHandle;
    private DotNetObjectReference<Lightbox>? _dotNetRef;
    private bool _swipeAttached;
    private bool _canShare;

    private PhotoItem CurrentPhoto => Photos[Math.Clamp(_index, 0, Photos.Count - 1)];

    private static bool HasMetadata(PhotoItem photo) =>
        !string.IsNullOrWhiteSpace(photo.CameraModel)
        || photo.FileSizeBytes is > 0
        || photo.Width is > 0 && photo.Height is > 0;

    protected override void OnParametersSet()
    {
        if (IsOpen)
            _index = Math.Clamp(InitialIndex, 0, Math.Max(0, Photos.Count - 1));
        else
            _swipeAttached = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsOpen || Photos.Count == 0)
        {
            await DisposeSwipeAsync();
            return;
        }

        if (_swipeAttached)
        {
            try { await _container.FocusAsync(); } catch { }
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/lightbox.js");

        if (!_canShare)
        {
            _canShare = await _module.InvokeAsync<bool>("canShare");
            if (_canShare)
                StateHasChanged();
        }

        _dotNetRef ??= DotNetObjectReference.Create(this);
        _swipeHandle = await _module.InvokeAsync<IJSObjectReference>("registerSwipe", _swipeArea, _dotNetRef);
        _swipeAttached = true;

        try { await _container.FocusAsync(); } catch { }
    }

    [JSInvokable]
    public Task OnSwipeLeft() => Next();

    [JSInvokable]
    public Task OnSwipeRight() => Previous();

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                await Close();
                break;
            case "ArrowLeft":
                await Previous();
                break;
            case "ArrowRight":
                await Next();
                break;
        }
    }

    private Task Next()
    {
        if (Photos.Count <= 1) return Task.CompletedTask;
        _index = (_index + 1) % Photos.Count;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task Previous()
    {
        if (Photos.Count <= 1) return Task.CompletedTask;
        _index = (_index - 1 + Photos.Count) % Photos.Count;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task Close() => OnClose.InvokeAsync();

    private async Task ShareAsync()
    {
        if (_module is null || !_canShare)
            return;

        var photo = CurrentPhoto;
        var title = PhotoQueries.FormatAlbumTitle(photo.Album);
        var text = $"{photo.Year}";
        if (PhotoQueries.FormatDisplayDate(photo.Date) is { } displayDate)
            text += $" · {displayDate}";

        await _module.InvokeAsync<object>("sharePhoto", new
        {
            url = photo.ImageUrl,
            title,
            text,
            fileName = photo.FileName
        });
    }

    private async Task DisposeSwipeAsync()
    {
        if (_swipeHandle is not null)
        {
            try { await _swipeHandle.InvokeVoidAsync("dispose"); }
            catch { }
            await _swipeHandle.DisposeAsync();
            _swipeHandle = null;
        }
        _swipeAttached = false;
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeSwipeAsync();
        _dotNetRef?.Dispose();
        if (_module is not null)
            await _module.DisposeAsync();
    }
}
