<header class="mb-8 space-y-4">
  <Breadcrumbs Year="@Year" Album="@Album" />
  @if (!string.IsNullOrEmpty(Title))
  {
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-50 sm:text-4xl">@Title</h1>
      @if (!string.IsNullOrEmpty(Subtitle))
      {
        <p class="mt-1 text-zinc-400">@Subtitle</p>
      }
    </div>
  }
</header>

@code {
  [Parameter] public string? Year { get; set; }
  [Parameter] public string? Album { get; set; }
  [Parameter] public string? Title { get; set; }
  [Parameter] public string? Subtitle { get; set; }
}
