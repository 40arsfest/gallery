<div class="grid grid-cols-2 gap-2 sm:grid-cols-3 sm:gap-3 md:grid-cols-4 lg:grid-cols-5 lg:gap-4"
     role="status"
     aria-busy="true"
     aria-label="Laddar foton">
    @for (var i = 0; i < Count; i++)
    {
        <SkeletonBlock Class="aspect-[4/3] rounded-xl" />
    }
</div>

@code {
    [Parameter] public int Count { get; set; } = 15;
}
