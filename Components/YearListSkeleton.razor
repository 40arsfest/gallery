<section aria-busy="true" aria-label="Laddar år">
    <SkeletonBlock Class="mb-4 h-7 w-12" />
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        @for (var i = 0; i < Count; i++)
        {
            <div class="flex min-h-[4.5rem] items-center justify-between gap-3 rounded-xl border border-zinc-800 bg-zinc-900/40 px-5 py-4">
                <SkeletonBlock Class="h-8 w-16" />
                <div class="flex flex-col items-end gap-2">
                    <SkeletonBlock Class="h-6 w-20 rounded-full" />
                    <SkeletonBlock Class="h-6 w-24 rounded-full" />
                </div>
            </div>
        }
    </div>
</section>

@code {
    [Parameter] public int Count { get; set; } = 6;
}
