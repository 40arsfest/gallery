@page "/year/{Year}"
@using PhotoGallery.Models
@using PhotoGallery.Services
@inject IPhotoService PhotoService
@inject NavigationManager Navigation

@if (_loading)
{
    <PageHeader Year="@Year" Title="@Year" />
    <SkeletonBlock Class="-mt-4 mb-8 h-4 w-24" />
    <AlbumListSkeleton />
}
else if (_albums.Count == 0)
{
    <p class="text-zinc-400">Inga album hittades för @Year.</p>
    <a href="@GalleryNavigation.Home(Navigation)" class="mt-4 inline-block text-amber-400 hover:text-amber-300">← Tillbaka till start</a>
}
else
{
    <PageHeader Year="@Year" Title="@Year" Subtitle="@($"{_photoCount} foton")" />

    <section>
        <h2 class="mb-4 text-xl font-semibold text-zinc-200">Album</h2>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            @foreach (var album in _albums)
            {
                <a href="@GalleryNavigation.Album(Navigation, Year, album.AlbumSlug)"
                   class="group rounded-xl border border-zinc-800 bg-zinc-900/80 p-5 shadow-md transition hover:border-amber-500/40 hover:bg-zinc-800/80">
                    <h3 class="text-lg font-semibold text-zinc-100 group-hover:text-amber-400">
                        @album.AlbumTitle
                    </h3>
                    @if (PhotoQueries.FormatDisplayDate(album.Date) is { } date)
                    {
                        <p class="mt-1 text-sm text-zinc-500">@date</p>
                    }
                    <p class="mt-1 text-sm text-zinc-500">@album.PhotoCount @(album.PhotoCount == 1 ? "foto" : "foton")</p>
                </a>
            }
        </div>
    </section>
}

@code {
    [Parameter] public string Year { get; set; } = "";

    private IReadOnlyList<AlbumSummary> _albums = [];
    private int _photoCount;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var albums = await PhotoService.GetAlbumsAsync(Year);
            _albums = PhotoQueries.OrderAlbums(albums).ToList();
            _photoCount = _albums.Sum(a => a.PhotoCount);
        }
        catch (HttpRequestException)
        {
            _albums = [];
        }
        finally
        {
            _loading = false;
        }
    }
}
